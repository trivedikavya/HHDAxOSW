# RepoMedic AI - environment configuration
# Copy this file to .env and adjust values as needed.
# No real credentials belong in this file or in .env - there is no API
# key to configure anywhere in this project.

# Server
PORT=5174

# Upload / archive safety limits (bytes unless noted)
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_EXTRACTED_TOTAL_SIZE_BYTES=104857600
MAX_EXTRACTED_FILE_COUNT=5000
MAX_SINGLE_FILE_SIZE_BYTES=5242880

# Client (Vite). Both are OPTIONAL for local dev - sensible defaults
# apply automatically (see client/src/lib/api.js). Only set these if you
# need to override the defaults, or when configuring a deployment (see
# DEPLOYMENT.md for the exact values to set on Vercel).
# VITE_API_BASE_URL=http://localhost:5174
# VITE_MAX_UPLOAD_SIZE_MB=25
# VITE_GITHUB_REPO_URL=https://github.com/your-org/repomedic-ai

# --- Phase 2: AI adapter (Ollama-compatible, local-only) ---
# No API key is used or required. See docs/ai-model.md for the exact
# tested model, its license, and local setup instructions.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
AI_REQUEST_TIMEOUT_MS=20000
AI_STATUS_TIMEOUT_MS=3000
