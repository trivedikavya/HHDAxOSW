# RepoMedic AI - environment configuration (Phase 1)
# Copy this file to .env and adjust values as needed.
# No real credentials belong in this file or in .env.

# Server
PORT=5174

# Upload / archive safety limits (bytes unless noted)
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_EXTRACTED_TOTAL_SIZE_BYTES=104857600
MAX_EXTRACTED_FILE_COUNT=5000
MAX_SINGLE_FILE_SIZE_BYTES=5242880

# Client (Vite) - base URL of the API the frontend talks to
VITE_API_BASE_URL=http://localhost:5174
